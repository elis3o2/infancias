# Copiar estas variables a backend/.env. No reemplazar el resto del archivo.
API_RNP=https://192.168.64.50:8533/v1/consulta
IDENTIDAD_API_KEY=
# Ruta absoluta, o relativa a backend/ (independiente del directorio de ejecución).
API_RNP_CA_PATH=certs/app1-identidad.crt
# El cliente de referencia usa POST con cuerpo JSON.
IDENTIDAD_HTTP_METHOD=POST
IDENTIDAD_USE_PROXY=False
# Archivo persistente compartido por TODOS los workers de este servidor.
IDENTIDAD_RATE_LIMIT_FILE=var/identidad-limites.json
